{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ke-town-api.cyber-e54.workers.dev/api/:path*"
    },
    {
      "source": "/((?!assets/|favicon|icon-|apple-touch-icon|og-image|robots.txt|sitemap.xml|site.webmanifest).*)",
      "destination": "/index.html"
    }
  ]
}
