# KE Kingdom Backend Environment Configuration

# Database Selection
# Set to 'mongo' for MongoDB (default) or 'mysql' for MySQL (cPanel)
DB_TYPE=mongo

# ============================================
# MongoDB Configuration (default)
# ============================================
# Multiple fallback URIs handled automatically by the app
# Primary: mongodb+srv://cybereliastk_db_user:...@cea.rz1xdmd.mongodb.net/keKingdom
# You can override with MONGO_URI if needed
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/keKingdom?retryWrites=true&w=majority

# ============================================
# MySQL Configuration (for cPanel)
# ============================================
# Only required when DB_TYPE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_cpanel_username
MYSQL_PASSWORD=your_cpanel_password
MYSQL_DATABASE=keKingdom
MYSQL_CHARSET=utf8mb4

# ============================================
# Server & Security
# ============================================
SERVER_NAME=primary
PORT=5000
JWT_SECRET=change-this-to-a-strong-secret-in-production
JWT_EXPIRE=7d

# SMTP (contact form emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@keKingdom.com.ng
