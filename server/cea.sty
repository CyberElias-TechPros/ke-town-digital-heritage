/**
 * scripts/seed.ts
 * Run with: ts-node --transpile-only scripts/seed.ts
 *
 * Requires: NODE_ENV, KEYSTONE_GRAPHQL_URL, ADMIN_EMAIL, ADMIN_PASSWORD
 *
 * This script:
 * - creates admin user if missing
 * - creates instructors, students
 * - creates courses, lessons, quizzes
 * - creates sample enrollments, certificates
 * - creates sample jobs and applications
 * - creates wallets & sample transactions
 */

import fetch from 'node-fetch';
import dotenv from 'dotenv';
dotenv.config();

const GRAPHQL = process.env.KEYSTONE_GRAPHQL_URL || 'http://localhost:3000/api/graphql';
const ADMIN_EMAIL = process.env.ADMIN_EMAIL || 'admin@cybereliasacademy.com.ng';
const ADMIN_PASSWORD = process.env.ADMIN_PASSWORD || 'ChangeMeNow123!';

async function runGQL(query: string, variables = {}, token?: string) {
  const res = await fetch(GRAPHQL, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
    body: JSON.stringify({ query, variables }),
  });
  const j = await res.json();
  if (j.errors) {
    console.error('GraphQL Errors:', j.errors);
    throw new Error('GraphQL request failed');
  }
  return j.data;
}

async function createAdmin() {
  console.log('Ensure admin user exists...');
  const findAdminQ = `
    query($email: String!) {
      users(where: { email: $email }) { id, email }
    }`;
  const data = await runGQL(findAdminQ, { email: ADMIN_EMAIL });
  if (data.users && data.users.length) {
    console.log('Admin exists:', ADMIN_EMAIL);
    return;
  }

  // Create user via Keystone mutation (uses createOneUser)
  const createQ = `
    mutation($name: String!, $email: String!, $password: String!, $role: String!) {
      createUser(data: { name: $name, email: $email, password: $password, role: $role }) { id email }
    }`;
  const created = await runGQL(createQ, {
    name: 'Administrator',
    email: ADMIN_EMAIL,
    password: ADMIN_PASSWORD,
    role: 'admin',
  });
  console.log('Created admin:', created.createUser.email);
}

async function loginAdminAndGetToken() {
  // If Keystone is configured with session cookie only, you may need to create an API token or run against a privileged seed API.
  // For simplicity, script assumes Keystone has a GraphQL endpoint that supports createSession mutation and returns a token.
  const q = `
    mutation($email:String!, $password:String!) {
      authenticateUserWithPassword(email: $email, password: $password) {
        token
        item { id email name }
      }
    }`;
  const data = await runGQL(q, { email: ADMIN_EMAIL, password: ADMIN_PASSWORD });
  if (!data.authenticateUserWithPassword) {
    throw new Error('Admin login failed. Ensure Keystone has "passwordAuth" configured.');
  }
  return data.authenticateUserWithPassword.token;
}

async function ensureSampleData(token: string) {
  // Create sample instructor
  console.log('Seeding sample users and courses...');
  const createUserQ = `
    mutation($name:String!, $email:String!, $password:String!, $role:String!) {
      createUser(data:{ name:$name, email:$email, password:$password, role:$role }) { id email name }
    }`;
  // Create Instructor
  const instEmail = 'instructor@cybereliasacademy.com.ng';
  await runGQL(`query { users(where:{ email: "${instEmail}" }) { id } }`);
  try {
    await runGQL(createUserQ, { name: 'Lead Instructor', email: instEmail, password: 'InstructorPass123!', role: 'instructor' }, token);
    console.log('Instructor created');
  } catch (e) {
    console.log('Instructor may already exist or create failed (continuing)...');
  }

  // Create 2 students
  const students = [
    { name: 'Amaka O', email: 'amaka@cybereliasacademy.com.ng' },
    { name: 'Tunde A', email: 'tunde@cybereliasacademy.com.ng' },
  ];
  for (const s of students) {
    try {
      await runGQL(createUserQ, { name: s.name, email: s.email, password: 'StudentPass123!', role: 'student' }, token);
    } catch { /* continue */ }
  }

  // Create Course
  const createCourseQ = `
    mutation($title:String!, $description:String!, $price:Int!, $instructorEmail:String!) {
      createCourse(data: { title: $title, description: $description, price: $price, instructor: { connect: { email: $instructorEmail } }, isPublished:true }) { id title }
    }`;
  await runGQL(createCourseQ, {
    title: 'Intro to Web Development',
    description: 'HTML, CSS, JavaScript, and responsive design — project-based.',
    price: 50000,
    instructorEmail: instEmail,
  }, token);

  // Fetch course id
  const courseData = await runGQL(`query { courses(where: { title: "Intro to Web Development" }) { id title } }`);
  const courseId = courseData.courses[0].id;

  // Create Lessons
  const createLessonQ = `
    mutation($title:String!, $content:String!, $courseId: ID!) {
      createLesson(data:{ title:$title, content:$content, course:{ connect: { id:$courseId } } }) { id title }
    }`;
  const lessons = [
    { title: 'HTML Fundamentals', content: 'HTML structure, tags, forms.' },
    { title: 'CSS Basics & Layout', content: 'Box model, flexbox, responsive design.' },
    { title: 'JavaScript Essentials', content: 'DOM manipulation, events, AJAX.' },
  ];
  for (const l of lessons) {
    await runGQL(createLessonQ, { title: l.title, content: l.content, courseId }, token);
  }

  // Enroll a student
  const enrollQ = `
    mutation($studentEmail:String!, $courseTitle:String!) {
      createEnrollment(data: { student: { connect: { email: $studentEmail } }, course: { connect: { title: $courseTitle } } }) { id }
    }`;
  await runGQL(enrollQ, { studentEmail: 'amaka@cybereliasacademy.com.ng', courseTitle: 'Intro to Web Development' }, token);
  console.log('Enrollment created for amaka');

  // Create Job and Application
  const createJobQ = `
    mutation($title:String!, $description:String!, $employerEmail:String!){
      createJob(data:{ title:$title, description:$description, employer:{ connect: { email:$employerEmail } } }) { id title }
    }`;
  // Create employer user
  try {
    await runGQL(createUserQ, { name: 'Tech Solutions Ltd', email: 'hr@techsolutions.ng', password: 'EmployerPass123!', role: 'employer' }, token);
  } catch {}
  await runGQL(createJobQ, { title: 'Junior Web Developer (Intern)', description: '3-month internship', employerEmail: 'hr@techsolutions.ng' }, token);

  // Fetch job id
  const jobData = await runGQL(`query { jobs(where: { title: "Junior Web Developer (Intern)" }) { id title } }`);
  const jobId = jobData.jobs[0].id;

  // Student applies
  const applyQ = `
    mutation($jobId:ID!, $applicantEmail:String!) {
      createApplication(data: { job: { connect: { id: $jobId } }, applicant: { connect: { email: $applicantEmail } }, coverLetter: "I am eager to learn and contribute."}) { id }
    }`;
  await runGQL(applyQ, { jobId, applicantEmail: 'amaka@cybereliasacademy.com.ng' }, token);
  console.log('Job application created');

  // Create Wallet for student and credit small test transaction
  const createWalletQ = `
    mutation($email:String!) {
      createWallet(data:{ user: { connect: { email: $email } }, balance: 0 }) { id }
    }`;
  try {
    await runGQL(createWalletQ, { email: 'amaka@cybereliasacademy.com.ng' }, token);
  } catch {}
  // Credit transaction
  const walletData = await runGQL(`query { wallets(where:{ user: { email: "amaka@cybereliasacademy.com.ng" }}) { id balance } }`, {}, token);
  if (walletData.wallets && walletData.wallets.length) {
    const walletId = walletData.wallets[0].id;
    const createTxnQ = `
      mutation($walletId: ID!, $amount: Float!, $type: String!, $description: String!) {
        createTransaction(data: { wallet: { connect: { id: $walletId } }, amount: $amount, type: $type, description: $description }) { id }
      }`;
    await runGQL(createTxnQ, { walletId, amount: 1000.0, type: 'credit', description: 'Test credit' }, token);
    console.log('Wallet transaction created');
  }

  console.log('Sample data seeded successfully.');
}

async function main() {
  try {
    await createAdmin();
    const token = await loginAdminAndGetToken();
    await ensureSampleData(token);
    console.log('All done.');
  } catch (err) {
    console.error('Seeding failed:', err);
  }
}

main();
