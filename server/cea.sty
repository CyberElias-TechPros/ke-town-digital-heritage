// storeHelpers.js
import { initDB } from './db';
import { v4 as uuidv4 } from 'uuid';

export const addCourse = async(courseObj) => {
  const db = await initDB();
  await db.put('courses', { ...courseObj, id: courseObj.id || uuidv4(), createdAt: Date.now() });
};

export const getCourses = async() => {
  const db = await initDB();
  return db.getAll('courses');
};

export const enrollUser = async({userId, courseId}) => {
  const db = await initDB();
  const id = uuidv4();
  const obj = { id, userId, courseId, progress: 0, enrolledAt: Date.now() };
  await db.put('enrollments', obj);
  await db.put('audit_logs', { id: uuidv4(), op: 'create', store: 'enrollments', payload: obj, timestamp: Date.now(), pending: true });
  return obj;
};
d) Sync stub
export const runSync = async() => {
  const db = await initDB();
  const tx = db.transaction(['audit_logs'], 'readwrite');
  const logs = await tx.store.getAll();
  const pending = logs.filter(l => l.pending);
  // Simulate sync
  for (const l of pending) {
    // pretend we POST l.payload to server and receive success
    l.pending = false;
    l.syncedAt = Date.now();
    await tx.store.put(l);
  }
  await tx.done;
  console.log('Sync completed');
};
