// pages/index.tsx
import React from 'react';
import useSWR from 'swr';
import { gql } from '../lib/gql';

const fetcher = (q: string) => gql(q);

export default function Home() {
  const { data, error } = useSWR(`{ allCourses { id title description price isPublished } }`, fetcher);

