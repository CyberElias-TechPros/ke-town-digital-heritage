def add_slide(title, bullets=None, subtitle=None, big=False):

    layout = prs.slide_layouts[5]  # Title Only

    slide = prs.slides.add_slide(layout)

    title_shape = slide.shapes.title

    title_shape.text = title

    title_shape.text_frame.paragraphs[0].font.size = PPt(40 if big else 32)

    # Add logo

    if os.path.exists(logo_path):

        left = PInches(8.5)

        top = PInches(0.2)

        slide.shapes.add_picture(logo_path, left, top, width=PInches(1.5))

    if subtitle:

        tx = slide.shapes.add_textbox(PInches(1), PInches(1.8), PInches(7.5), PInches(1))

        tf = tx.text_frame

        tf.text = subtitle

    if bullets:

        txBox = slide.shapes.add_textbox(PInches(1), PInches(2.2), PInches(8), PInches(4.5))

        tf = txBox.text_frame

        tf.clear()

        for i, b in enumerate(bullets):

            p = tf.add_paragraph()

            p.text = b

            p.level = 0

            p.font.size = PPt(20)

    return slide



