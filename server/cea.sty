// schema.ts
import { list } from '@keystone-6/core';
import { text, relationship, timestamp, integer, select, checkbox, password, json, float } from '@keystone-6/core/fields';
import { allowAll } from '@keystone-6/core/access';

export const lists = {
  // =========================
  // USER MANAGEMENT
  // =========================
  User: list({
    access: allowAll,
    fields: {
      name: text({ validation: { isRequired: true } }),
      email: text({ isIndexed: 'unique', validation: { isRequired: true } }),
      password: password({ validation: { isRequired: true } }),
      role: select({
        options: [
          { label: 'Admin', value: 'admin' },
          { label: 'Instructor', value: 'instructor' },
          { label: 'Student', value: 'student' },
          { label: 'Employer', value: 'employer' },
          { label: 'Partner', value: 'partner' },
        ],
        defaultValue: 'student',
        ui: { displayMode: 'segmented-control' },
      }),
      phone: text(),
      bio: text({ ui: { displayMode: 'textarea' } }),
      avatar: text(),
      enrollments: relationship({ ref: 'Enrollment.student', many: true }),
      jobs: relationship({ ref: 'Job.employer', many: true }),
      wallet: relationship({ ref: 'Wallet.user', many: false }),
      createdAt: timestamp({ defaultValue: { kind: 'now' } }),
    },
    ui: {
      listView: {
        initialColumns: ['name', 'email', 'role', 'createdAt'],
      },
    },
  }),

  // =========================
  // COURSES & LEARNING MODULES
  // =========================
  Course: list({
    access: allowAll,
    fields: {
      title: text({ validation: { isRequired: true } }),
      description: text({ ui: { displayMode: 'textarea' } }),
      price: integer(),
      duration: text(),
