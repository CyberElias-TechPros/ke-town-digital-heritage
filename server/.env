# Server Identity (primary or secondary)
SERVER_NAME=primary

# Other servers for health checking/syncing
OTHER_SERVERS=https://kesrv.freegameplay.site,https://ke-town-digital-heritage-production.up.railway.app

# Server
PORT=5000

# SMTP settings for contact form emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@keKingdom.com.ng

# JWT Secret (change in production)
JWT_SECRET=keKingdom-secret-key-2024

# ============================================
# MySQL Database Configuration (for cPanel)
# ============================================
# Set to 'mysql' to use MySQL instead of MongoDB
DB_TYPE=mongo

# MySQL connection settings (cPanel compatible)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=your_cpanel_username
MYSQL_PASSWORD=your_cpanel_password
MYSQL_DATABASE=keKingdom
MYSQL_CHARSET=utf8mb4