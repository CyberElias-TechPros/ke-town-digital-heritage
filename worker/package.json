{
  "name": "ke-kingdom-cf-worker",
  "version": "1.0.0",
  "description": "KE Kingdom Digital Heritage — Cloudflare Workers + D1 backend",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply ke_kingdom --local",
    "db:migrate:remote": "wrangler d1 migrations apply ke_kingdom --remote",
    "db:seed:local": "wrangler d1 execute ke_kingdom --local --file=./seed.sql",
    "db:reset:local": "wrangler d1 execute ke_kingdom --local --command='DROP TABLE IF EXISTS users'",
    "test": "node --test test/lib.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^3.100.0"
  }
}
