# KE Kingdom Cloudflare Worker — environment / secrets reference
#
# Set real values with `npx wrangler secret put <NAME>` (NOT in wrangler.toml).
# These are read at runtime via `env`.

# Required — long random string used to sign/verify session JWTs.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Deployment environment. Set to "production" in production.
ENVIRONMENT=development

# (Optional) Public base URL used when building media URLs. When unset, the
# Worker uses the incoming request origin.
PUBLIC_UPLOAD_BASE=

# Email delivery (contact forms / notifications). Cloudflare has no built-in
# SMTP; wire an Email Worker or an email provider here in production.
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=admin@keKingdom.com.ng
